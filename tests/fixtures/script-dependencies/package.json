{
  "name": "script-dependencies",
  "private": true,
  "scripts": {
    "start": "node -r dotenv/config index.js",
    "dev": "npx --yes nodemon index.js | pino-pretty",
    "build": "cross-env NODE_ENV=production tsc -p .",
    "test": "NODE_ENV=test jest --coverage && eslint .",
    "seed": "dotenv -e .env -- node index.js; docker compose up",
    "check": "npm run test"
  },
  "dependencies": {
    "dotenv": "^16.0.0",
    "pino-pretty": "^11.0.0"
  },
  "devDependencies": {
    "cross-env": "^7.0.0",
    "dotenv-cli": "^7.0.0",
    "eslint": "^9.0.0",
    "jest": "^29.0.0",
    "left-pad": "^1.3.0",
    "nodemon": "^3.0.0",
    "typescript": "^5.0.0"
  }
}
